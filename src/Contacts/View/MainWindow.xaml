<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="509" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <GroupBox x:Name="EditContactGroupBox" Header="Edit Contact" HorizontalAlignment="Left" Width="380" Margin="15,15,0,0" VerticalAlignment="Top" Height="433">
            <StackPanel>
                <Label x:Name="EditContactNameLabel" Content="Name:"/>
                <TextBox x:Name="EditContactNameTextBox" TextWrapping="Wrap" Text="TextBox" Margin="3,0,3,0"/>
                <Label x:Name="EditContactPhoneNumberLabel" Content="Phone Number:"/>
                <TextBox x:Name="EditContactPhoneNumberTextBox" TextWrapping="Wrap" Text="TextBox" Margin="3,0,3,0"/>
                <Label x:Name="EditContactEmailLabel" Content="Email:"/>
                <TextBox x:Name="EditContactEmailTextBox" TextWrapping="Wrap" Text="TextBox" Margin="3,0,3,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="ReadContactGroupBox" Header="Read Contact" HorizontalAlignment="Right" Margin="0,15,15,0" Width="380" VerticalAlignment="Top" Height="433">
            <StackPanel>
                <Label x:Name="ReadContactNameLabel" Content="Name:"/>
                <Label x:Name="ReadContactNameBoldLabel" Content="Name" FontWeight="Bold"/>
                <Label x:Name="ReadContactPhoneNumberLabel" Content="Phone Number:"/>
                <Label x:Name="ReadContactPhoneNumberBoldLabel" Content="Phone Number" FontWeight="Bold"/>
                <Label x:Name="ReadContactEmailLabel" Content="Email:"/>
                <Label x:Name="ReadContactEmailBoldLabel" Content="Email" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="LoadButton" Content="Load" HorizontalAlignment="Right" Margin="0,0,15,15" VerticalAlignment="Bottom" Width="75" Height="25"/>
        <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Right" Margin="0,0,93,15" VerticalAlignment="Bottom" Width="75" Height="25"/>
    </Grid>
</Window>
