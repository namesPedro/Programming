<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="800">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<GroupBox Grid.Column="0" Grid.Row="0" Header="Edit Contact" Margin="3">
			<StackPanel Margin="3">
				<Label Content="Name:" Margin="3"/>
				<TextBox TextWrapping="Wrap" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="3" HorizontalAlignment="Stretch"/>
				<Label Content="Phone Number:" Margin="3"/>
				<TextBox TextWrapping="Wrap" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="3" HorizontalAlignment="Stretch"/>
				<Label Content="Email:" Margin="3"/>
				<TextBox TextWrapping="Wrap" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="3" HorizontalAlignment="Stretch"/>
			</StackPanel>
		</GroupBox>

		<GroupBox Grid.Column="1" Grid.Row="0" Header="Read Contact" Margin="3">
			<StackPanel Margin="3">
				<Label Content="Name:" Margin="3"/>
				<Label Content="{Binding Name}" FontWeight="Bold" Margin="3"/>
				<Label Content="Phone Number:" Margin="3"/>
				<Label Content="{Binding PhoneNumber}" FontWeight="Bold" Margin="3"/>
				<Label Content="Email:" Margin="3"/>
				<Label Content="{Binding Email}" FontWeight="Bold" Margin="3"/>
			</StackPanel>
		</GroupBox>

		<StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3">
			<Button Content="Save" Width="75" Height="25" Margin="0,0,3,0" Command="{Binding SaveCommand}"/>
			<Button Content="Load" Width="75" Height="25" Command="{Binding LoadCommand}"/>
		</StackPanel>
	</Grid>
</Window>