<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:controls="clr-namespace:View.Controls"
        xmlns:converters="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Contacts" Height="500" Width="900">

	<Window.Resources>
		<!-- Шаблон для элементов списка (Задание 4, пункт 1) -->
		<DataTemplate x:Key="ContactItemTemplate">
			<StackPanel Margin="3">
				<TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
				<TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="Gray"/>
			</StackPanel>
		</DataTemplate>

		<!-- Конвертер видимости для Apply -->
		<converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>

	<Grid>
		<!-- Левая колонка (*), Разделитель, Правая колонка (2*) -->
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="3"/>
			<ColumnDefinition Width="2*"/>
		</Grid.ColumnDefinitions>

		<!-- ЛЕВАЯ ПАНЕЛЬ (Список и управление) -->
		<Border Grid.Column="0" Background="#f8f8f8" Padding="8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Список контактов с кастомным шаблоном -->
				<ListBox Grid.Row="0" 
                         ItemsSource="{Binding Contacts}" 
                         SelectedItem="{Binding SelectedContact}"
                         ItemTemplate="{StaticResource ContactItemTemplate}" 
                         Margin="3"/>

				<!-- Кнопки управления (адаптивная ширина через Grid) -->
				<Grid Grid.Row="1" Margin="3">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" Content="Add" Height="25" Command="{Binding AddCommand}" Margin="3"/>
					<Button Grid.Column="1" Content="Edit" Height="25" Command="{Binding EditCommand}" Margin="3"/>
					<Button Grid.Column="2" Content="Remove" Height="25" Command="{Binding RemoveCommand}" Margin="3"/>
				</Grid>
			</Grid>
		</Border>

		<!-- РАЗДЕЛИТЕЛЬ -->
		<GridSplitter Grid.Column="1" Width="3" Background="White" HorizontalAlignment="Stretch"/>

		<!-- ПРАВАЯ ПАНЕЛЬ (Детали контакта + Apply) -->
		<Border Grid.Column="2" Background="White" Padding="8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Пользовательский контрол (Задание 4, пункт 2) -->
				<controls:ContactControl Grid.Row="0" DataContext="{Binding SelectedContact}" Margin="3"/>

				<!-- Кнопка Apply (Задание 4, пункт 3) -->
				<Button Grid.Row="1" Content="Apply" Width="75" Height="25" Margin="3,50,3,3" HorizontalAlignment="Left"
                        Command="{Binding ApplyCommand}" 
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding CanApply}"/>
			</Grid>
		</Border>
	</Grid>
</Window>